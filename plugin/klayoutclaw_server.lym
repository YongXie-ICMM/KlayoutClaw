# ---------------------------------------------------------------------------
# View refresh helper
# ---------------------------------------------------------------------------

_LAYER_STYLES = {
    # (layer, datatype): (fill_color, frame_color, transparent)
    # Colors as 0xRRGGBB integers
    (1, 0): (0x4169E1, 0x1A3A8A, False),   # Mesa: royal blue, solid
    (2, 0): (0xFF8C00, 0xB35F00, True),     # Metal: dark orange, transparent
    (3, 0): (0xFFD700, 0xB39700, False),    # Pads: gold, solid
    (4, 0): (0x32CD32, 0x1E7A1E, True),     # green, transparent
    (5, 0): (0xDC143C, 0x8B0A25, False),    # crimson, solid
    (6, 0): (0x8A2BE2, 0x5A1D96, True),     # violet, transparent
}

_FALLBACK_COLORS = [
    0x17BECF, 0xE377C2, 0x7F7F7F, 0xBCBD22,
    0x8C564B, 0x9467BD, 0xD62728, 0x2CA02C,
]


def _refresh_view():
    """Update KLayout's GUI to show current layout state with per-layer styling."""
    global _layout_view, _layout
    if _layout_view is None or _layout is None:
        return
    fallback_idx = 0
    layers_added = False
    for li in _layout.layer_indices():
        info = _layout.get_info(li)
        key = (info.layer, info.datatype)
        # Check if this layer already has a layer properties entry
        found = False
        lp_iter = _layout_view.begin_layers()
        while not lp_iter.at_end():
            lp = lp_iter.current()
            if lp.source_layer == info.layer and lp.source_datatype == info.datatype:
                found = True
                break
            lp_iter.next()
        if not found:
            lp = pya.LayerProperties()
            lp.source_layer = info.layer
            lp.source_datatype = info.datatype
            style = _LAYER_STYLES.get(key)
            if style:
                lp.fill_color = style[0]
                lp.frame_color = style[1]
                lp.transparent = style[2]
            else:
                c = _FALLBACK_COLORS[fallback_idx % len(_FALLBACK_COLORS)]
                lp.fill_color = c
                lp.frame_color = c
                lp.transparent = True
                fallback_idx += 1
            _layout_view.insert_layer(lp_iter, lp)
            layers_added = True
    if layers_added:
        _layout_view.zoom_fit()


# ---------------------------------------------------------------------------
# Tool handlers — all run on Qt main thread (no dispatch needed)
# ---------------------------------------------------------------------------

def _tool_create_layout(args):
    global _layout_view, _layout, _top_cell
    name = args.get("name", "TOP")
    dbu = args.get("dbu", 0.001)
    mw = pya.Application.instance().main_window()
    # mw.create_layout(1) opens a new tab/panel with a fresh empty layout
    # and auto-switches mw.current_view() to it, while leaving any existing
    # tabs (with their cells, polygons, and image annotations) intact.
    # Mode 0 instead *replaces* the current view's layout in-place, which
    # wipes the user's existing work and also inherits the previous view's
    # pya.Image annotations. Mode 1 gives the natural "new blank layout"
    # behaviour you'd expect.
    mw.create_layout(1)
    _layout_view = mw.current_view()
    cv = _layout_view.active_cellview()
    _layout = cv.layout()
    _layout.dbu = dbu
    _top_cell = _layout.create_cell(name)
    _layout_view.active_cellview().cell = _top_cell
    _refresh_view()
    return json.dumps({"status": "ok", "top_cell": _top_cell.name, "dbu": dbu})


def _tool_execute_script(args):
    global _layout, _layout_view, _top_cell, _exec_seq
    _ensure_valid_handles()
    code = args.get("code")
    if not code:
        raise ValueError("Missing required parameter: code")
    # Auto-save code block to /tmp/KLayout_Execute/ (best-effort, never blocks execution)
    _exec_seq += 1
    try:
        _save_dir = "/tmp/KLayout_Execute"
        os.makedirs(_save_dir, exist_ok=True)
        _ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
        _save_name = "{}_{:04d}.py".format(_ts, _exec_seq)
        _save_path = os.path.join(_save_dir, _save_name)
        with open(_save_path, "w", encoding="utf-8") as _sf:
            _sf.write("# KlayoutClaw execute_script auto-save\n# timestamp: {}\n# sequence: {}\n\n".format(_ts, _exec_seq) + code)
    except Exception:
        pass  # auto-save is best-effort
    ns = {
        "pya": pya,
        "json": json,
        "os": os,
        "_layout": _layout,
        "_layout_view": _layout_view,
        "_top_cell": _top_cell,
        "_get_or_create_view": _get_or_create_view,
        "_refresh_view": _refresh_view,
    }
    # Capture stdout/stderr during execution
    _captured_stdout = io.StringIO()
    _captured_stderr = io.StringIO()
    _old_stdout = sys.stdout
    _old_stderr = sys.stderr
    sys.stdout = _captured_stdout
    sys.stderr = _captured_stderr
    try:
        exec(code, ns)
    except Exception as e:
        # Capture output before re-raising
        _err_stdout = _captured_stdout.getvalue()
        _err_stderr = _captured_stderr.getvalue()
        # Format a readable error with traceback pointing to user code lines
        tb_lines = _tb_mod.format_exception(type(e), e, e.__traceback__)
        # Filter to show only the &lt;string&gt; (user code) frames
        user_frames = []
        for line in _tb_mod.format_tb(e.__traceback__):
            if '&lt;string&gt;' in line:
                user_frames.append(line.strip())
        err_msg = "{}: {}".format(type(e).__name__, e)
        if user_frames:
            err_msg += "\n  in user code:\n    " + "\n    ".join(user_frames)
        if _err_stdout:
            err_msg += "\n  stdout: " + _err_stdout.rstrip()
        if _err_stderr:
            err_msg += "\n  stderr: " + _err_stderr.rstrip()
        raise RuntimeError(err_msg)
    finally:
        sys.stdout = _old_stdout
        sys.stderr = _old_stderr
    _stdout_val = _captured_stdout.getvalue()
    _stderr_val = _captured_stderr.getvalue()
    # Update globals in case script called _get_or_create_view()
    if ns.get("_layout") is not _layout:
        _layout = ns["_layout"]
    if ns.get("_layout_view") is not _layout_view:
        _layout_view = ns["_layout_view"]
    if ns.get("_top_cell") is not _top_cell:
        _top_cell = ns["_top_cell"]
    _refresh_view()
    result = ns.get("result", {"status": "ok"})
    if not isinstance(result, dict):
        result = {"status": "ok", "result": result}
    result["stdout"] = _stdout_val
    result["stderr"] = _stderr_val
    return json.dumps(result)


def _tool_save_layout(args):
    global _layout
    _ensure_valid_handles()
    filepath = args.get("filepath")
    fmt = args.get("format", "GDS2")
    if not filepath:
        raise ValueError("Missing required parameter: filepath")
    abs_path = os.path.abspath(filepath)
    save_opts = pya.SaveLayoutOptions()
    if fmt.upper() == "OASIS":
        save_opts.format = "OASIS"
    else:
        save_opts.format = "GDS2"
    _layout.write(abs_path, save_opts)
    return json.dumps({"status": "ok", "filepath": abs_path, "format": fmt})


def _tool_get_layout_info(args):
    global _layout, _top_cell
    _ensure_valid_handles()
    cells = []
    # Use each_cell() instead of range(layout.cells()) because the cell
    # count can include holes in the index space after Layout.read() merges
    # GDS content with cell-name collisions (KLayout leaves orphaned slots).
    cell_bboxes = {}
    for c in _layout.each_cell():
        cells.append(c.name)
        try:
            bb = c.bbox()
            if not bb.empty():
                cell_bboxes[c.name] = {
                    "bbox_dbu": [bb.left, bb.bottom, bb.right, bb.top],
                    "bbox_um": [
                        round(bb.left * _layout.dbu, 6),
                        round(bb.bottom * _layout.dbu, 6),
                        round(bb.right * _layout.dbu, 6),
                        round(bb.top * _layout.dbu, 6),
                    ],
                    "bbox_units": "dbu and um (see bbox_dbu and bbox_um)",
                }
        except Exception:
            pass
    dbu = _layout.dbu
    layers = {}
    for li in _layout.layer_indices():
        info = _layout.get_info(li)
        layer_spec = "{}/{}".format(info.layer, info.datatype)
        shape_count = 0
        region = pya.Region()
        # Use RecursiveShapeIterator for recursive shape collection across all cells
        rsi = _top_cell.begin_shapes_rec(li)
        while not rsi.at_end():
            shape_count += 1
            s = rsi.shape()
            if not s.is_text():
                region.insert(s.polygon)
            rsi.next()
        area_um2 = round(region.area() * dbu * dbu, 6)
        bbox_um = None
        bbox_dbu = None
        if not region.is_empty():
            bb = region.bbox()
            bbox_dbu = [bb.left, bb.bottom, bb.right, bb.top]
            bbox_um = [
                round(bb.left * dbu, 6),
                round(bb.bottom * dbu, 6),
                round(bb.right * dbu, 6),
                round(bb.top * dbu, 6),
            ]
        layers[layer_spec] = {
            "shapes": shape_count,
            "area_um2": area_um2,
            "bbox_um": bbox_um,
            "bbox_dbu": bbox_dbu,
            "bbox_units": "bbox_um is micrometers, bbox_dbu is database units",
        }
    num_layers = len(layers)
    return json.dumps({
        "status": "ok",
        "dbu": dbu,
        "dbu_um": dbu,  # micrometers per database unit (same as dbu; explicit label for clarity)
        "units": "All *_um fields are micrometers; *_dbu fields are database units. dbu_um converts dbu->um.",
        "num_cells": len(cells),
        "cells": cells,
        "cell_bboxes": cell_bboxes,
        "num_layers": num_layers,
        "layers": layers,
    })


def _tool_screenshot(args):
    """Capture the current KLayout viewport as a PNG image."""
    global _layout_view
    _ensure_valid_handles()
    if _layout_view is None:
        raise ValueError("No layout view available to capture")

    filepath = args.get("filepath", "/tmp/klayoutclaw_screenshot.png")
    width = args.get("width", 1024)
    height = args.get("height", 768)
    zoom_box = args.get("zoom_box", None)
    abs_path = os.path.abspath(filepath)

    if zoom_box is not None:
        if not isinstance(zoom_box, (list, tuple)) or len(zoom_box) != 4:
            raise ValueError("zoom_box must be a 4-element list [x1, y1, x2, y2] in micrometers")
        try:
            x1, y1, x2, y2 = [float(v) for v in zoom_box]
        except (TypeError, ValueError) as e:
            raise ValueError("zoom_box values must be numeric: {}".format(e))
        _layout_view.zoom_box(pya.DBox(x1, y1, x2, y2))
        _log("screenshot: zoom_box set to [{}, {}, {}, {}]".format(x1, y1, x2, y2))

    _layout_view.save_image(abs_path, width, height)
    _log("screenshot: saved {}x{} to {}".format(width, height, abs_path))
    return json.dumps({"status": "ok", "filepath": abs_path, "width": width, "height": height})


def _tool_auto_route(args):
    """Route connections between pin pairs using external route_worker.py."""
    import tempfile
    import subprocess

    global _layout, _layout_view, _top_cell
    _ensure_valid_handles()

    pin_layer_a = args.get("pin_layer_a")
    pin_layer_b = args.get("pin_layer_b")
    if not pin_layer_a or not pin_layer_b:
        raise ValueError("Missing required parameters: pin_layer_a and pin_layer_b. Both must be layer specs like '102/0'.")

    obstacle_layers = args.get("obstacle_layers", [])
    output_layer = args.get("output_layer", "10/0")
    path_width = args.get("path_width", 10.0)
    obs_safe_distance = args.get("obs_safe_distance", 5.0)
    path_safe_distance = args.get("path_safe_distance", 5.0)
    map_resolution = args.get("map_resolution", 2.0)
    conda_env = args.get("conda_env", "instrMCPdev")
    python_path = args.get("python_path", None)
    obs_hardness = args.get("obs_hardness", 20.0)
    pin_safe_distance_a = args.get("pin_safe_distance_a", 5.0)
    pin_safe_distance_b = args.get("pin_safe_distance_b", 5.0)
    path_hardness = args.get("path_hardness", 10.0)
    sort_pairs = args.get("sort_pairs", True)
    # Clamp timeout to [10, 600] seconds
    try:
        timeout_sec = float(args.get("timeout", 120))
    except (TypeError, ValueError):
        timeout_sec = 120.0
    if timeout_sec &lt; 10:
        timeout_sec = 10.0
    elif timeout_sec &gt; 600:
        timeout_sec = 600.0
    try:
        obs_damping_step = int(args.get("obs_damping_step", 4))
    except (TypeError, ValueError):
        obs_damping_step = 4

    # P4 additions
    dry_run = bool(args.get("dry_run", False))
    auto_map_resolution = bool(args.get("auto_map_resolution", False))
    per_pair_obstacle_layers = args.get("per_pair_obstacle_layers", None)
    if per_pair_obstacle_layers is not None and not isinstance(per_pair_obstacle_layers, list):
        raise ValueError("per_pair_obstacle_layers must be a list of lists of layer spec strings (or null/omitted).")

    # Save current layout to temp GDS
    tmp_dir = tempfile.mkdtemp(prefix="klayoutclaw_route_")
    input_gds = os.path.join(tmp_dir, "input.gds")
    config_json = os.path.join(tmp_dir, "config.json")
    output_json = os.path.join(tmp_dir, "output.json")

    save_opts = pya.SaveLayoutOptions()
    save_opts.format = "GDS2"
    _layout.write(input_gds, save_opts)
    _log("auto_route: saved layout to {}".format(input_gds))

    # Write config JSON (field names must match route_worker.py expectations)
    config = {
        "gds_path": input_gds,
        "output_path": output_json,
        "cell_name": _top_cell.name if _top_cell else "TOP",
        "dbu": _layout.dbu,
        "pin_layer_a": pin_layer_a,
        "pin_layer_b": pin_layer_b,
        "obstacle_layers": obstacle_layers,
        "output_layer": output_layer,
        "path_width_um": path_width,
        "obs_safe_distance_um": obs_safe_distance,
        "path_safe_distance_um": path_safe_distance,
        "map_resolution_um": map_resolution,
        "obs_hardness": obs_hardness,
        "pin_safe_distance_a_um": pin_safe_distance_a,
        "pin_safe_distance_b_um": pin_safe_distance_b,
        "path_hardness": path_hardness,
        "sort_pairs": sort_pairs,
        "obs_damping_step": obs_damping_step,
        "dry_run": dry_run,
        "auto_map_resolution": auto_map_resolution,
    }
    if per_pair_obstacle_layers is not None:
        config["per_pair_obstacle_layers"] = per_pair_obstacle_layers
    with open(config_json, "w") as f:
        json.dump(config, f)

    # Find route_worker.py
    worker_candidates = [
        os.path.expanduser("~/Documents/GitHub/KlayoutClaw/tools/route_worker.py"),
        os.path.expanduser("~/.klayout/pymacros/route_worker.py"),
    ]
    # Also check directory of __file__ if available
    try:
        worker_candidates.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "route_worker.py"))
    except Exception:
        pass
    worker_path = None
    for wp in worker_candidates:
        if os.path.isfile(wp):
            worker_path = wp
            break
    if worker_path is None:
        raise ValueError("route_worker.py not found. Install the plugin with 'python install.py' or place route_worker.py in one of: " + ", ".join(worker_candidates))
    _log("auto_route: using worker {}".format(worker_path))

    # Spawn subprocess
    if python_path:
        cmd = "{} {} {}".format(python_path, worker_path, config_json)
    else:
        conda_sh = None
        for p in [os.path.expanduser("~/miniforge3/etc/profile.d/conda.sh"),
                   os.path.expanduser("~/anaconda3/etc/profile.d/conda.sh"),
                   os.path.expanduser("~/miniconda3/etc/profile.d/conda.sh")]:
            if os.path.isfile(p):
                conda_sh = p
                break
        if conda_sh is None:
            raise ValueError("conda.sh not found. Checked miniforge3, anaconda3, miniconda3.")
        cmd = 'source {} &amp;&amp; conda activate {} &amp;&amp; python {} {}'.format(
            conda_sh,
            conda_env, worker_path, config_json
        )
    _log("auto_route: running: {}".format(cmd))
    try:
        proc = subprocess.run(
            ["bash", "-c", cmd],
            capture_output=True, text=True, timeout=timeout_sec
        )
    except subprocess.TimeoutExpired:
        raise ValueError("Routing timed out after {} seconds. The layout may be too complex — try increasing map_resolution, reducing obstacles, or raising the 'timeout' parameter (max 600).".format(int(timeout_sec)))
    except Exception as e:
        raise ValueError("Failed to run route_worker.py subprocess: {}".format(e))

    # Check output JSON first — worker writes structured errors there before exit(1)
    if os.path.isfile(output_json):
        with open(output_json, "r") as f:
            result = json.load(f)
        if result.get("status") == "error":
            raise ValueError("Routing failed: {}".format("; ".join(result.get("errors", ["unknown"]))))
    elif proc.returncode != 0:
        _log("auto_route stderr: {}".format(proc.stderr))
        stderr = proc.stderr.strip()
        err_lines = [l for l in stderr.split("\n") if l.strip()]
        last_err = err_lines[-1] if err_lines else "unknown error"
        raise ValueError("Routing subprocess failed (exit code {}): {}\nFull stderr:\n{}".format(
            proc.returncode, last_err, stderr[:500]))
    else:
        raise ValueError("route_worker.py ran but produced no output file. This usually means it crashed before writing results.\nstdout: {}\nstderr: {}".format(
            proc.stdout[:300], proc.stderr[:300]))

    # Dry-run: route_worker returns status="dry_run" with pairs[] preview and
    # no paths[]. Skip the insert loop and return the preview directly so the
    # layout is untouched.
    if result.get("status") == "dry_run":
        try:
            os.remove(input_gds)
            os.remove(config_json)
            os.remove(output_json)
            os.rmdir(tmp_dir)
        except Exception:
            pass
        preview_pairs = result.get("pairs", [])
        return json.dumps({
            "status": "dry_run",
            "routed_pairs": 0,
            "total_pins_a": result.get("total_pins_a", 0),
            "total_pins_b": result.get("total_pins_b", 0),
            "pairs": preview_pairs,
            "map_resolution_um_used": result.get("map_resolution_um_used", map_resolution),
            "errors": result.get("errors", []),
            "next_step_suggestion": (
                "dry_run preview: {} Hungarian assignments computed, no routes inserted. "
                "Review the pairs[] array — if the matching looks good, call auto_route again with dry_run=false. "
                "If a pair looks wrong, flag obstacles via per_pair_obstacle_layers[pair_idx] before the real run."
            ).format(len(preview_pairs)),
        })

    # Insert routed paths into layout
    ol_parts = output_layer.split("/")
    ol_num = int(ol_parts[0])
    ol_dt = int(ol_parts[1]) if len(ol_parts) &gt; 1 else 0
    layer_idx = _layout.layer(ol_num, ol_dt)
    dbu = _layout.dbu
    path_width_dbu = int(round(path_width / dbu))

    routes = result.get("paths", [])
    inserted = 0
    for route in routes:
        pts = route.get("points_dbu", [])
        if len(pts) &lt; 2:
            continue
        path_obj = pya.Path(
            [pya.Point(int(round(p[0])), int(round(p[1]))) for p in pts],
            path_width_dbu
        )
        _top_cell.shapes(layer_idx).insert(path_obj)
        inserted += 1

    _refresh_view()
    _log("auto_route: inserted {} paths".format(inserted))

    # Cleanup temp files
    try:
        os.remove(input_gds)
        os.remove(config_json)
        os.remove(output_json)
        os.rmdir(tmp_dir)
    except Exception:
        pass

    # Compose a next_step_suggestion pointing the agent at the inspection
    # tools most relevant to the outcome. Static string — the intent is to
    # nudge the agent, not to prescribe.
    n_errors = len(result.get("errors", []))
    status = result.get("status", "unknown")
    total_pairs = min(result.get("total_pins_a", 0), result.get("total_pins_b", 0))
    if status == "success" and n_errors == 0 and inserted == total_pairs:
        next_step = ("Routes committed. Call screenshot (optionally with zoom_box over the device region) to visually verify, "
                     "then route_inspect to map each route_id back to its contact/pad, "
                     "and evaluate_design with contact_isolation to detect crossings.")
    elif inserted &gt; 0:
        next_step = ("Partial routing ({}/{} pairs). Call route_inspect to see which pairs succeeded, "
                     "screenshot(zoom_box=...) over the unrouted region, and consider per_pair_obstacle_layers or a higher timeout for the retry.".format(inserted, total_pairs))
    else:
        next_step = ("No routes inserted. Re-check pin_layer_a / pin_layer_b have geometry via get_layout_info, "
                     "try dry_run=True first to preview Hungarian matching, and consult the errors list.")

    return json.dumps({
        "status": status,
        "routed_pairs": inserted,
        "total_pins_a": result.get("total_pins_a", 0),
        "total_pins_b": result.get("total_pins_b", 0),
        "output_layer": output_layer,
        "path_width_um": path_width,
        "map_resolution_um_used": result.get("map_resolution_um_used", map_resolution),
        "errors": result.get("errors", []),
        "next_step_suggestion": next_step,
    })


def _iter_routes_on_layer(layer_num, datatype):
    """Yield (route_id, endpoints_dbu, length_dbu, polygon) for every route-shaped
    object on the given (layer, datatype). Handles both pya.Path shapes and
    polygons (paths get converted to polygons via Region for crossing detection,
    but spine endpoints are preserved from the Path for accuracy).

    Returns a list of dicts, ordered stably: paths first (in shape-iteration
    order), then polygons. route_id is the index into the returned list and
    matches the indexing used by evaluate_design's contact_isolation
    crossing_pairs — agents can cross-reference the two tools safely.
    """
    global _layout, _top_cell
    layer_idx = _layout.layer(layer_num, datatype)
    routes = []
    # Single pass over recursive shapes so the indexing is stable for
    # cross-tool reference (matches evaluate_worker order-of-iteration).
    rsi = _top_cell.begin_shapes_rec(layer_idx)
    while not rsi.at_end():
        shape = rsi.shape()
        try:
            if shape.is_path():
                path = shape.path
                pts = list(path.each_point())
                if len(pts) &gt;= 2:
                    length_dbu = 0
                    for i in range(len(pts) - 1):
                        length_dbu += pts[i].distance(pts[i + 1])
                    routes.append({
                        "kind": "path",
                        "endpoints_dbu": [(pts[0].x, pts[0].y), (pts[-1].x, pts[-1].y)],
                        "length_dbu": length_dbu,
                        "polygon": shape.polygon,  # pya.Polygon of the path outline
                    })
            elif shape.is_polygon() or shape.is_simple_polygon() or shape.is_box():
                poly = shape.polygon
                # For polygons, approximate endpoints as the two most distant
                # vertices — matches evaluate_worker's fallback logic.
                hull_pts = list(poly.each_point_hull())
                if len(hull_pts) &gt;= 2:
                    max_d = 0
                    ep_a = hull_pts[0]
                    ep_b = hull_pts[1]
                    for i in range(len(hull_pts)):
                        for j in range(i + 1, len(hull_pts)):
                            d = hull_pts[i].distance(hull_pts[j])
                            if d &gt; max_d:
                                max_d = d
                                ep_a = hull_pts[i]
                                ep_b = hull_pts[j]
                    routes.append({
                        "kind": "polygon",
                        "endpoints_dbu": [(ep_a.x, ep_a.y), (ep_b.x, ep_b.y)],
                        "length_dbu": max_d,
                        "polygon": poly,
                    })
        except Exception:
            # Defensive: skip shapes we can't inspect rather than crash
            pass
        rsi.next()
    return routes


def _parse_layer_spec(spec):
    """Parse 'L/DT' strings into (layer, datatype) ints. Returns None on failure."""
    try:
        parts = str(spec).split("/")
        return (int(parts[0]), int(parts[1]) if len(parts) &gt; 1 else 0)
    except (ValueError, AttributeError):
        return None


def _tool_route_inspect(args):
    """Report per-route metadata (contact, pad, length, crossings) for every
    route on the given layer. Read-only — never modifies the layout.

    route_id in the output matches the indexing used by evaluate_design's
    contact_isolation.crossing_pairs, so agents can cross-reference the two
    tools without re-deriving the order.
    """
    global _layout, _top_cell
    _ensure_valid_handles()

    route_spec = args.get("route_layer")
    if not route_spec:
        raise ValueError("route_layer is required (e.g. '3/0')")
    rl = _parse_layer_spec(route_spec)
    if rl is None:
        raise ValueError("Invalid route_layer spec '{}'. Expected 'L/DT' (e.g. '3/0').".format(route_spec))

    contact_specs = args.get("contact_layers")
    if contact_specs is None:
        raise ValueError(
            "route_inspect: 'contact_layers' is required (list of layer specs "
            "the route endpoints land on). No default is assumed.")
    if isinstance(contact_specs, str):
        contact_specs = [contact_specs]

    pad_spec = args.get("pad_layer")
    if not pad_spec:
        raise ValueError(
            "route_inspect: 'pad_layer' is required (layer spec for bonding "
            "pads). No default is assumed.")
    tolerance_um = float(args.get("tolerance_um", 5.0))

    dbu = _layout.dbu
    tolerance_dbu = int(round(tolerance_um / dbu))

    # Walk route shapes on route_layer
    routes = _iter_routes_on_layer(rl[0], rl[1])

    # Collect contact shapes per layer (with centroids) and build a flat list
    contact_entries = []  # [{layer, shape_idx, centroid_um, region, bbox_dbu}, ...]
    for cspec in contact_specs:
        cl = _parse_layer_spec(cspec)
        if cl is None:
            continue
        li = _layout.layer(cl[0], cl[1])
        rsi = _top_cell.begin_shapes_rec(li)
        idx = 0
        while not rsi.at_end():
            s = rsi.shape()
            if not s.is_text():
                try:
                    poly = s.polygon
                    bb = poly.bbox()
                    cx_dbu = (bb.left + bb.right) / 2.0
                    cy_dbu = (bb.bottom + bb.top) / 2.0
                    contact_entries.append({
                        "layer": cspec,
                        "shape_idx": idx,
                        "centroid_um": [round(cx_dbu * dbu, 4), round(cy_dbu * dbu, 4)],
                        "centroid_dbu": (cx_dbu, cy_dbu),
                        "region": pya.Region(poly),
                    })
                    idx += 1
                except Exception:
                    pass
            rsi.next()

    # Collect pad shapes
    pad_entries = []
    pl = _parse_layer_spec(pad_spec)
    if pl is not None:
        pli = _layout.layer(pl[0], pl[1])
        rsi = _top_cell.begin_shapes_rec(pli)
        idx = 0
        while not rsi.at_end():
            s = rsi.shape()
            if not s.is_text():
                try:
                    poly = s.polygon
                    bb = poly.bbox()
                    cx_dbu = (bb.left + bb.right) / 2.0
                    cy_dbu = (bb.bottom + bb.top) / 2.0
                    pad_entries.append({
                        "layer": pad_spec,
                        "shape_idx": idx,
                        "centroid_um": [round(cx_dbu * dbu, 4), round(cy_dbu * dbu, 4)],
                        "centroid_dbu": (cx_dbu, cy_dbu),
                        "region": pya.Region(poly),
                    })
                    idx += 1
                except Exception:
                    pass
            rsi.next()

    # Helper: find the closest shape to a given (x, y) in dbu, within tolerance
    def _closest_shape(entries, ep_dbu, tolerance_dbu):
        best = None
        best_d = float("inf")
        ex, ey = ep_dbu
        for entry in entries:
            cx, cy = entry["centroid_dbu"]
            # Prefer point-in-region (endpoint actually lands on the shape)
            pt_region = pya.Region(pya.Box(
                int(ex) - tolerance_dbu, int(ey) - tolerance_dbu,
                int(ex) + tolerance_dbu, int(ey) + tolerance_dbu,
            ))
            if not (entry["region"] &amp; pt_region).is_empty():
                # Endpoint touches shape; use centroid distance as ranker
                d = ((ex - cx) ** 2 + (ey - cy) ** 2) ** 0.5
                if d &lt; best_d:
                    best_d = d
                    best = entry
        if best is not None:
            return best
        # Fallback: nearest centroid within tolerance
        for entry in entries:
            cx, cy = entry["centroid_dbu"]
            d = ((ex - cx) ** 2 + (ey - cy) ** 2) ** 0.5
            if d &lt;= tolerance_dbu and d &lt; best_d:
                best_d = d
                best = entry
        return best

    # Per-route classification
    out_routes = []
    for ridx, r in enumerate(routes):
        ep_a_dbu, ep_b_dbu = r["endpoints_dbu"]
        contact_match = _closest_shape(contact_entries, ep_a_dbu, tolerance_dbu) or \
                        _closest_shape(contact_entries, ep_b_dbu, tolerance_dbu)
        pad_match = _closest_shape(pad_entries, ep_b_dbu, tolerance_dbu) or \
                    _closest_shape(pad_entries, ep_a_dbu, tolerance_dbu)

        from_contact = None
        if contact_match is not None:
            from_contact = {
                "layer": contact_match["layer"],
                "shape_idx": contact_match["shape_idx"],
                "centroid_um": contact_match["centroid_um"],
            }
        to_pad = None
        if pad_match is not None:
            to_pad = {
                "layer": pad_match["layer"],
                "shape_idx": pad_match["shape_idx"],
                "centroid_um": pad_match["centroid_um"],
            }

        out_routes.append({
            "route_id": ridx,
            "kind": r["kind"],
            "layer": route_spec,
            "length_um": round(r["length_dbu"] * dbu, 4),
            "endpoints_um": [
                [round(ep_a_dbu[0] * dbu, 4), round(ep_a_dbu[1] * dbu, 4)],
                [round(ep_b_dbu[0] * dbu, 4), round(ep_b_dbu[1] * dbu, 4)],
            ],
            "from_contact": from_contact,
            "to_pad": to_pad,
        })

    # Crossings among routes on this same layer (uses raw polygon areas — no
    # junction filtering, so adjacent-at-endpoint shapes that touch mid-body
    # will show up here; agents typically read this alongside
    # evaluate_design's contact_isolation.crossing_pairs which applies the
    # junction filter).
    crossings = []
    for i in range(len(routes)):
        for j in range(i + 1, len(routes)):
            inter = routes[i]["polygon"] &amp; routes[j]["polygon"] if hasattr(routes[i]["polygon"], "__and__") else None
            if inter is None:
                ri_reg = pya.Region(routes[i]["polygon"])
                rj_reg = pya.Region(routes[j]["polygon"])
                ov = ri_reg &amp; rj_reg
            else:
                ov = pya.Region(inter)
            if ov.is_empty():
                continue
            area_um2 = round(ov.area() * dbu * dbu, 4)
            if area_um2 &gt; 0.01:
                crossings.append([i, j, area_um2])

    # next_step_suggestion
    n_unmapped = sum(1 for r in out_routes if r["from_contact"] is None or r["to_pad"] is None)
    if crossings:
        next_step = ("{} crossing(s) detected. Inspect crossing_pairs (route_idx_A, route_idx_B, overlap_um2) and call screenshot(zoom_box=...) over each pair. Consider re-running auto_route with narrower path_width, per_pair_obstacle_layers, or dry_run first.".format(len(crossings)))
    elif n_unmapped:
        next_step = ("{} route(s) are missing a contact or pad assignment (endpoints outside tolerance_um={}). Raise tolerance_um or check that pin_layer_a/b in the original auto_route call match the contact/pad layers you expected.".format(n_unmapped, tolerance_um))
    else:
        next_step = ("All {} routes mapped to contact + pad with no crossings. Run evaluate_design with contact_isolation + connectivity + route_endpoints to confirm full scoring.".format(len(out_routes)))

    return json.dumps({
        "status": "ok",
        "route_layer": route_spec,
        "num_routes": len(out_routes),
        "routes": out_routes,
        "crossings": crossings,
        "crossing_pairs_format": "[route_idx_A, route_idx_B, overlap_um2]",
        "next_step_suggestion": next_step,
    })


def _tool_evaluate_design(args):
    """Evaluate device design against spatial quality checks using external evaluate_worker.py."""
    import tempfile
    import subprocess

    global _layout, _layout_view, _top_cell
    _ensure_valid_handles()

    layer_map = args.get("layer_map", {})
    checks = args.get("checks", None)
    reference_gds = args.get("reference_gds", None)
    python_path = args.get("python_path", None)
    conda_env = args.get("conda_env", "instrMCPdev")

    # Clamp timeout to [60, 900] seconds (default 300)
    try:
        timeout_sec = float(args.get("timeout", 300))
    except (TypeError, ValueError):
        timeout_sec = 300.0
    if timeout_sec &lt; 60:
        timeout_sec = 60.0
    elif timeout_sec &gt; 900:
        timeout_sec = 900.0

    if checks is None or not isinstance(checks, list) or len(checks) == 0:
        raise ValueError("'checks' must be a non-empty list of check objects.")

    # Validate check structure before spawning subprocess
    _known_primitives = ["component_overlap", "component_containment",
                         "bulk_containment", "arm_material_class",
                         "contact_isolation", "connectivity", "route_endpoints",
                         "adjacency", "solidity", "spacing"]
    _required_args = {
        "component_overlap": ["component", "region"],
        "component_containment": ["component", "region"],
        "bulk_containment": ["component"],
        "arm_material_class": ["component", "classes"],
        "contact_isolation": [],
        "connectivity": [],
        "route_endpoints": [],
        "adjacency": ["component_a", "component_b"],
        "solidity": ["component"],
        "spacing": ["component_a"],
    }
    for i, check in enumerate(checks):
        if not isinstance(check, dict):
            raise ValueError("checks[{}] must be a dict with 'name', 'args', 'weight'. Got: {}".format(i, type(check).__name__))
        name = check.get("name")
        if not name:
            raise ValueError("checks[{}] missing 'name'. Each check needs {{name, args, weight}}.".format(i))
        if name not in _known_primitives:
            raise ValueError("checks[{}]: unknown primitive '{}'. Available: {}".format(i, name, ", ".join(_known_primitives)))
        check_args = check.get("args")
        if check_args is None or not isinstance(check_args, dict):
            raise ValueError("checks[{}] ('{}') missing 'args' dict. Each check needs {{name, args, weight}}.".format(i, name))
        if "weight" not in check:
            raise ValueError("checks[{}] ('{}') missing 'weight'. Each check needs {{name, args, weight}}.".format(i, name))
        for req in _required_args.get(name, []):
            if req not in check_args:
                raise ValueError("checks[{}] ('{}') missing required arg '{}'. Required args: {}".format(
                    i, name, req, _required_args[name]))
        # Validate that component/region args reference keys in layer_map
        _component_keys = ["component", "component_a", "component_b", "contact_component",
                           "pad_component", "route_component"]
        for key in _component_keys:
            val = check_args.get(key)
            if val is not None and val not in layer_map:
                raise ValueError("checks[{}] ('{}') arg '{}' = '{}' not found in layer_map. "
                                 "Available keys: {}".format(i, name, key, val, list(layer_map.keys())))
        region_val = check_args.get("region")
        if region_val is not None:
            region_list = [region_val] if isinstance(region_val, str) else region_val
            for rv in region_list:
                if rv not in layer_map:
                    raise ValueError("checks[{}] ('{}') region '{}' not found in layer_map. "
                                     "Available keys: {}".format(i, name, rv, list(layer_map.keys())))
        targets = check_args.get("target_components")
        if targets is not None:
            for t in targets:
                if t not in layer_map:
                    raise ValueError("checks[{}] ('{}') target_component '{}' not found in layer_map. "
                                     "Available keys: {}".format(i, name, t, list(layer_map.keys())))

    # Validate layer_map format
    for lname, lspec in layer_map.items():
        if isinstance(lspec, str):
            raise ValueError("layer_map['{}'] = '{}' is a string. Expected [layer, datatype] (e.g. [20, 0]) "
                             "or {{\"layer\": 20, \"datatype\": 0}}.".format(lname, lspec))

    # Save current layout to temp GDS
    tmp_dir = tempfile.mkdtemp(prefix="klayoutclaw_eval_")
    input_gds = os.path.join(tmp_dir, "input.gds")
    config_json = os.path.join(tmp_dir, "config.json")
    output_json = os.path.join(tmp_dir, "output.json")

    try:
        save_opts = pya.SaveLayoutOptions()
        save_opts.format = "GDS2"
        _layout.write(input_gds, save_opts)
        _log("evaluate_design: saved layout to {}".format(input_gds))

        # Write config JSON
        config = {
            "gds_path": input_gds,
            "layer_map": layer_map,
            "checks": checks,
            "output_path": output_json,
        }
        if reference_gds:
            config["reference_gds"] = reference_gds
        with open(config_json, "w") as f:
            json.dump(config, f)

        # Find evaluate_worker.py
        worker_candidates = [
            os.path.expanduser("~/Documents/GitHub/KlayoutClaw/tools/evaluate_worker.py"),
            os.path.expanduser("~/testFolder/KlayoutClaw/tools/evaluate_worker.py"),
            os.path.expanduser("~/.klayout/pymacros/evaluate_worker.py"),
        ]
        try:
            worker_candidates.insert(0, os.path.join(os.path.dirname(os.path.abspath(__file__)), "evaluate_worker.py"))
        except Exception:
            pass
        worker_path = None
        for wp in worker_candidates:
            if os.path.isfile(wp):
                worker_path = wp
                break
        if worker_path is None:
            raise ValueError("evaluate_worker.py not found. Searched: " + ", ".join(worker_candidates))
        _log("evaluate_design: using worker {}".format(worker_path))

        # Spawn subprocess
        if python_path:
            cmd = "{} {} {}".format(python_path, worker_path, config_json)
        else:
            conda_sh = None
            for p in [os.path.expanduser("~/miniforge3/etc/profile.d/conda.sh"),
                       os.path.expanduser("~/anaconda3/etc/profile.d/conda.sh"),
                       os.path.expanduser("~/miniconda3/etc/profile.d/conda.sh")]:
                if os.path.isfile(p):
                    conda_sh = p
                    break
            if conda_sh is None:
                raise ValueError("conda.sh not found. Checked miniforge3, anaconda3, miniconda3.")
            cmd = 'source {} &amp;&amp; conda activate {} &amp;&amp; python {} {}'.format(
                conda_sh, conda_env, worker_path, config_json
            )
        _log("evaluate_design: running: {}".format(cmd))
        try:
            proc = subprocess.run(
                ["bash", "-c", cmd],
                capture_output=True, text=True, timeout=timeout_sec
            )
        except subprocess.TimeoutExpired:
            raise ValueError("Evaluation timed out after {} seconds. Layout may be too complex — raise the 'timeout' parameter (max 900) or reduce the number of checks.".format(int(timeout_sec)))
        except Exception as e:
            raise ValueError("Failed to run evaluate_worker.py: {}".format(e))

        if proc.returncode != 0:
            _log("evaluate_design stderr: {}".format(proc.stderr))
            stderr = proc.stderr.strip()
            err_lines = [l for l in stderr.split("\n") if l.strip()]
            last_err = err_lines[-1] if err_lines else "unknown error"
            raise ValueError("Evaluation subprocess failed (exit code {}): {}".format(proc.returncode, last_err))

        # Read output
        if not os.path.isfile(output_json):
            raise ValueError("evaluate_worker.py produced no output file.\nstdout: {}\nstderr: {}".format(
                proc.stdout[:300], proc.stderr[:300]))

        with open(output_json, "r") as f:
            result = json.load(f)

        if result.get("status") == "error":
            raise ValueError("Evaluation failed: {}".format(result.get("error", "unknown")))

        return json.dumps(result)

    finally:
        # Cleanup temp files
        for p in [input_gds, config_json, output_json]:
            try:
                os.remove(p)
            except Exception:
                pass
        try:
            os.rmdir(tmp_dir)
        except Exception:
            pass


def _tool_validate_pixel_size(args):
    """Validate pixel_size and optionally compute marker spacing from a GDS template."""
    pixel_size = args.get("pixel_size")
    template_gds = args.get("template_gds", None)
    image_path = args.get("image_path", None)
    if pixel_size is None:
        raise ValueError("Missing required parameter: pixel_size")

    warnings = []
    valid = True

    # Check range [0.01, 2.0]
    if pixel_size &lt; 0.01 or pixel_size &gt; 2.0:
        valid = False
        warnings.append("pixel_size {} is outside valid range [0.01, 2.0] um/px".format(pixel_size))

    # Map to likely objective magnification
    objective_map = [
        (0.05, "100x"),
        (0.087, "100x"),
        (0.1, "50x"),
        (0.25, "20x"),
        (0.5, "10x"),
    ]
    likely_objective = None
    best_dist = float("inf")
    for ref_ps, obj_label in objective_map:
        dist = abs(pixel_size - ref_ps)
        if dist &lt; best_dist:
            best_dist = dist
            likely_objective = obj_label

    # Compute marker_spacing_um from template_gds if provided
    marker_spacing_um = None
    if template_gds:
        try:
            tl = pya.Layout()
            tl.read(template_gds)
            # Find L5/0 layer
            l5_idx = None
            for li in tl.layer_indices():
                linfo = tl.get_info(li)
                if linfo.layer == 5 and linfo.datatype == 0:
                    l5_idx = li
                    break
            if l5_idx is not None and tl.top_cell() is not None:
                tc = tl.top_cell()
                shape_centroids = []
                rsi = tc.begin_shapes_rec(l5_idx)
                while not rsi.at_end():
                    s = rsi.shape()
                    if not s.is_text():
                        bb = s.bbox()
                        cx = (bb.left + bb.right) / 2.0
                        cy = (bb.bottom + bb.top) / 2.0
                        shape_centroids.append((cx, cy))
                    rsi.next()
                if len(shape_centroids) &gt;= 2:
                    tdbu = tl.dbu
                    # Cluster nearby shapes into markers
                    # (handles multi-polygon markers like crosses)
                    cluster_radius = 20.0 / tdbu  # 20 um in dbu
                    clusters = []  # list of [sum_x, sum_y, count]
                    for (sx, sy) in shape_centroids:
                        merged = False
                        for cl in clusters:
                            mcx = cl[0] / cl[2]
                            mcy = cl[1] / cl[2]
                            dx = sx - mcx
                            dy = sy - mcy
                            if (dx * dx + dy * dy) ** 0.5 &lt; cluster_radius:
                                cl[0] += sx
                                cl[1] += sy
                                cl[2] += 1
                                merged = True
                                break
                        if not merged:
                            clusters.append([sx, sy, 1])
                    if len(clusters) &gt;= 2:
                        marker_centers = [(cl[0] / cl[2], cl[1] / cl[2]) for cl in clusters]
                        min_dist = float("inf")
                        for i in range(len(marker_centers)):
                            for j in range(i + 1, len(marker_centers)):
                                dx = marker_centers[i][0] - marker_centers[j][0]
                                dy = marker_centers[i][1] - marker_centers[j][1]
                                d = (dx * dx + dy * dy) ** 0.5
                                if d &lt; min_dist:
                                    min_dist = d
                        marker_spacing_um = round(min_dist * tdbu, 6)
                    else:
                        warnings.append("GDS template has fewer than 2 L5/0 markers (after clustering)")
                else:
                    warnings.append("GDS template has fewer than 2 L5/0 markers")
            else:
                warnings.append("GDS template has no L5/0 layer or no top cell")
        except Exception as e:
            warnings.append("Failed to read template_gds: {}".format(e))

    return json.dumps({
        "status": "ok",
        "valid": valid,
        "pixel_size": pixel_size,
        "likely_objective": likely_objective,
        "warnings": warnings,
        "marker_spacing_um": marker_spacing_um,
    })


def _tool_close_layout_view(args):
    """Close one or more KLayout layout tabs.

    Modes (when 'index' is omitted):
      - 'others' (default) — close every tab except the currently active one
      - 'current'          — close only the active tab
      - 'all'              — close every open tab
    If 'index' is provided, close that specific tab instead (by 0-based index).
    After closing, re-acquires MCP handles so subsequent tool calls see a valid view.
    """
    global _layout, _layout_view, _top_cell
    mw = pya.Application.instance().main_window()
    if mw is None:
        return json.dumps({"status": "error", "error": "no main window"})

    initial_count = mw.views()
    if initial_count == 0:
        return json.dumps({"status": "ok", "closed": 0, "remaining": 0, "note": "no views to close"})

    index = args.get("index")
    mode = args.get("mode", "others")

    # Snapshot the currently active view so we can keep it across closes
    try:
        cur_view = mw.current_view()
        active_id = id(cur_view) if cur_view is not None else None
    except Exception:
        active_id = None

    # Collect (index, id) for all open views up front — indices shift as we close
    view_ids = []
    for i in range(initial_count):
        v = mw.view(i)
        if v is not None:
            view_ids.append(id(v))

    # Decide which view ids to close
    targets = []
    if index is not None:
        try:
            idx = int(index)
        except (TypeError, ValueError):
            return json.dumps({"status": "error", "error": "'index' must be an integer"})
        if idx &lt; 0 or idx &gt;= initial_count:
            return json.dumps({"status": "error", "error": "index {} out of range [0, {})".format(idx, initial_count)})
        targets.append(view_ids[idx])
    elif mode == "current":
        if active_id is not None:
            targets.append(active_id)
    elif mode == "all":
        targets = list(view_ids)
    elif mode == "others":
        targets = [vid for vid in view_ids if vid != active_id]
    else:
        return json.dumps({"status": "error", "error": "mode must be one of: current, others, all"})

    closed = 0
    errors = []
    for vid in targets:
        # Re-find the view by id — indices shift after each close
        found_idx = None
        for i in range(mw.views()):
            v = mw.view(i)
            if v is not None and id(v) == vid:
                found_idx = i
                break
        if found_idx is None:
            continue
        try:
            # Mark the view's layouts as non-dirty so KLayout doesn't pop up
            # a modal "Save changes?" dialog (which would block the MCP server
            # on the Qt main thread). We do this by writing each cellview out
            # to a throwaway temp file via LayoutView.save_as(cv_idx, path, opts)
            # — KLayout considers a freshly-saved layout clean (is_dirty() flips
            # to False after save_as). The temp file is left on disk (OS cleans
            # /tmp / $TMPDIR).
            target_view = mw.view(found_idx)
            if target_view is not None:
                try:
                    if target_view.is_dirty():
                        for ci in range(target_view.cellviews()):
                            tmp_fd, tmp_path = tempfile.mkstemp(
                                prefix="klayoutclaw_close_", suffix=".gds")
                            os.close(tmp_fd)
                            try:
                                target_view.save_as(ci, tmp_path, pya.SaveLayoutOptions())
                            except Exception as save_err:
                                _log("close_layout_view: save_as failed for cv {} ({}); attempting close anyway".format(ci, save_err))
                except Exception as mark_err:
                    _log("close_layout_view: mark-clean pass failed: {}".format(mark_err))
            mw.select_view(found_idx)
            mw.close_current_view()
            closed += 1
        except Exception as e:
            errors.append("failed to close view id={}: {}".format(vid, e))

    remaining = mw.views()

    # After closing, our module-level _layout / _layout_view / _top_cell may
    # point at a destroyed object. Re-acquire handles so the next tool call
    # doesn't segfault. If no views remain, the next create_layout will rebuild.
    try:
        if remaining &gt; 0:
            _layout_view = mw.current_view()
            if _layout_view is not None:
                cv = _layout_view.active_cellview()
                _layout = cv.layout() if cv is not None else None
                _top_cell = cv.cell if cv is not None else None
        else:
            _layout = None
            _layout_view = None
            _top_cell = None
    except Exception as e:
        errors.append("handle refresh after close failed: {}".format(e))

    _refresh_view() if remaining &gt; 0 else None

    result = {"status": "ok", "closed": closed, "remaining": remaining, "mode": mode}
    if index is not None:
        result["index"] = int(index)
    if errors:
        result["errors"] = errors
    return json.dumps(result)


_TOOL_DISPATCH = {
    "create_layout": _tool_create_layout,
    "execute_script": _tool_execute_script,
    "save_layout": _tool_save_layout,
    "get_layout_info": _tool_get_layout_info,
    "screenshot": _tool_screenshot,
    "auto_route": _tool_auto_route,
    "route_inspect": _tool_route_inspect,
    "evaluate_design": _tool_evaluate_design,
    "validate_pixel_size": _tool_validate_pixel_size,
    "close_layout_view": _tool_close_layout_view,
}


# ---------------------------------------------------------------------------
# JSON-RPC 2.0 dispatcher
# ---------------------------------------------------------------------------

MAX_BODY_SIZE = 1 * 1024 * 1024  # 1 MB

# Guard against re-entrant / parallel tool calls.
# QTcpServer runs on the Qt main thread. If waitForReadyRead() processes
# events during a long-running tool, a second newConnection signal can
# fire and try to execute another tool concurrently — corrupting shared
# layout state. We track whether a tool is running and return an
# immediate retry-friendly error to the second caller.
_tool_busy = False
_tool_busy_name = None


def _handle_jsonrpc(body_str):
    """Parse a JSON-RPC 2.0 request and return (response_dict_or_None, http_status)."""
    global _tool_busy, _tool_busy_name
    try:
        req = json.loads(body_str)
    except (json.JSONDecodeError, ValueError) as e:
        return {"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error: " + str(e)}}, 200

    req_id = req.get("id")
    method = req.get("method")
    params = req.get("params", {})

    _log("JSON-RPC method={} id={}".format(method, req_id))

    if not method:
        return {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32600, "message": "Invalid Request: missing method"}}, 200

    # --- initialize ---
    if method == "initialize":
        sid = _ensure_session()
        result = {
            "protocolVersion": "2025-03-26",
            "capabilities": {"tools": {}},
            "serverInfo": {"name": "KlayoutClaw", "version": "0.6"}
        }
        _notify_request(method, True)
        return {"jsonrpc": "2.0", "id": req_id, "result": result}, 200

    # --- notifications/initialized ---
    if method == "notifications/initialized":
        # Notification — no response body needed
        return None, 200

    # --- tools/list ---
    if method == "tools/list":
        result = {"tools": TOOLS}
        _notify_request(method, True)
        return {"jsonrpc": "2.0", "id": req_id, "result": result}, 200

    # --- tools/call ---
    if method == "tools/call":
        tool_name = params.get("name")
        tool_args = params.get("arguments", {})
        handler = _TOOL_DISPATCH.get(tool_name)
        if handler is None:
            err_msg = "Tool '{}' not found. Available tools: {}".format(
                tool_name, ", ".join(sorted(_TOOL_DISPATCH.keys())))
            return {"jsonrpc": "2.0", "id": req_id, "result": {
                "content": [{"type": "text", "text": err_msg}], "isError": True}}, 200

        # Reject parallel tool calls — the server is single-threaded
        if _tool_busy:
            err_msg = (
                "Server busy: '{}' is currently running. "
                "KLayout MCP server is single-threaded and cannot handle parallel tool calls. "
                "Please wait for it to finish, then retry '{}'. "
                "Hint: call tools sequentially, not in parallel."
            ).format(_tool_busy_name, tool_name)
            _log("BUSY: rejected '{}' while '{}' is running".format(tool_name, _tool_busy_name))
            _notify_request("tools/call:" + tool_name, False, "server busy")
            return {"jsonrpc": "2.0", "id": req_id, "result": {
                "content": [{"type": "text", "text": err_msg}], "isError": True}}, 200

        _tool_busy = True
        _tool_busy_name = tool_name
        try:
            result_str = handler(tool_args)
            _notify_request("tools/call:" + tool_name, True)
            return {"jsonrpc": "2.0", "id": req_id, "result": {"content": [{"type": "text", "text": result_str}]}}, 200
        except Exception as e:
            # Return tool errors as MCP results with isError=true so
            # the client can display them as readable tool output
            tb_str = _tb_mod.format_exc()
            _log("Tool error: {} — {}\n{}".format(tool_name, e, tb_str))
            _notify_request("tools/call:" + tool_name, False, str(e))
            # Build a human-readable error message
            err_parts = ["Tool '{}' failed: {}".format(tool_name, e)]
            # For execute_script, the RuntimeError already has user-code context
            # For other tools, add a short traceback hint
            if tool_name != "execute_script":
                # Include the last few relevant traceback lines
                tb_lines = tb_str.strip().split("\n")
                if len(tb_lines) &gt; 2:
                    err_parts.append("Traceback (last 3 lines):")
                    for tl in tb_lines[-3:]:
                        err_parts.append("  " + tl)
            return {"jsonrpc": "2.0", "id": req_id, "result": {
                "content": [{"type": "text", "text": "\n".join(err_parts)}], "isError": True}}, 200
        finally:
            _tool_busy = False
            _tool_busy_name = None

    # --- unknown method ---
    return {"jsonrpc": "2.0", "id": req_id, "error": {"code": -32601, "message": "Method not found: {}".format(method)}}, 200


# ---------------------------------------------------------------------------
# HTTP helpers
# ---------------------------------------------------------------------------

def _http_response(status_code, body_str, extra_headers=None):
    """Build a complete HTTP/1.0 response string."""
    reason = {200: "OK", 400: "Bad Request", 404: "Not Found", 405: "Method Not Allowed", 413: "Payload Too Large", 500: "Internal Server Error"}.get(status_code, "Error")
    headers = "HTTP/1.0 {} {}\r\n".format(status_code, reason)
    headers += "Content-Type: application/json\r\n"
    headers += "Connection: close\r\n"
    if _session_id:
        headers += "Mcp-Session-Id: {}\r\n".format(_session_id)
    if extra_headers:
        for k, v in extra_headers.items():
            headers += "{}: {}\r\n".format(k, v)
    body_bytes = body_str.encode("utf-8") if body_str else b""
    headers += "Content-Length: {}\r\n".format(len(body_bytes))
    headers += "\r\n"
    return headers.encode("utf-8") + body_bytes


# ---------------------------------------------------------------------------
# QTcpServer subclass
# ---------------------------------------------------------------------------

class KlayoutClawServer(pya.QTcpServer):

    def __init__(self, parent=None):
        super(KlayoutClawServer, self).__init__(parent)
        ha = pya.QHostAddress("127.0.0.1")
        ok = self.listen(ha, 8765)
        if not ok:
            _log("ERROR: Failed to bind to 127.0.0.1:8765 — port may be in use")
            return
        _log("MCP server listening on 127.0.0.1:8765")
        cb = sys.modules.get("_klayoutclaw")
        if cb:
            cb.server_port = 8765
            if cb.on_server_start:
                cb.on_server_start(8765)
        self.newConnection(self.on_new_connection)

    def on_new_connection(self):
        try:
            connection = self.nextPendingConnection()
            self._handle_request(connection)
        except Exception as ex:
            _log("ERROR in on_new_connection: " + str(ex))

    def _handle_request(self, conn):
        try:
            # --- Read HTTP request line and headers ---
            method = None
            path = None
            content_length = 0
            chunked = False
            headers_done = False
            session_header = None

            while conn.isOpen() and conn.state() == pya.QTcpSocket.ConnectedState:
                if conn.canReadLine():
                    raw = conn.readLine()
                    line = raw.decode("utf-8", errors="replace").rstrip("\r\n")
                    if line == "":
                        headers_done = True
                        break
                    if method is None:
                        # Request line: METHOD /path HTTP/1.x
                        m = re.match(r"^(GET|POST|PUT|DELETE|OPTIONS)\s+(\S+)\s+HTTP/", line)
                        if m:
                            method = m.group(1)
                            path = m.group(2)
                    else:
                        # Header line
                        hm = re.match(r"^([^:]+):\s*(.*)", line)
                        if hm:
                            hname = hm.group(1).lower()
                            hval = hm.group(2).strip()
                            if hname == "content-length":
                                try:
                                    content_length = int(hval)
                                except ValueError:
                                    pass
                            elif hname == "transfer-encoding" and "chunked" in hval.lower():
                                chunked = True
                            elif hname == "mcp-session-id":
                                session_header = hval
                else:
                    conn.waitForReadyRead(100)

            if method is None:
                conn.write(_http_response(400, json.dumps({"error": "Bad Request"})))
                self._close_connection(conn)
                return

            _log("HTTP {} {}".format(method, path))

            # Validate session if present
            if session_header and _session_id and session_header != _session_id:
                _log("WARNING: Session ID mismatch (got {}, expected {})".format(session_header, _session_id))

            # Reject chunked
            if chunked:
                conn.write(_http_response(400, json.dumps({"error": "Chunked transfer encoding not supported"})))
                self._close_connection(conn)
                return

            # Enforce max body size
            if content_length &gt; MAX_BODY_SIZE:
                conn.write(_http_response(413, json.dumps({"error": "Payload too large (max 1MB)"})))
                self._close_connection(conn)
                return

            # --- Read body for POST ---
            body = b""
            if method == "POST" and content_length &gt; 0:
                while len(body) &lt; content_length:
                    if conn.bytesAvailable() &gt; 0:
                        chunk = conn.read(content_length - len(body))
                        if isinstance(chunk, bytes):
                            body += chunk
                        else:
                            body += chunk.encode("utf-8")
                    else:
                        if not conn.waitForReadyRead(100):
                            break

            # --- Route ---
            if method == "GET" and path == "/mcp":
                resp_body = json.dumps({"status": "ok", "server": "KlayoutClaw", "version": "0.6"})
                conn.write(_http_response(200, resp_body))

            elif method == "POST" and path == "/mcp":
                body_str = body.decode("utf-8") if isinstance(body, bytes) else body
                rpc_resp, status = _handle_jsonrpc(body_str)
                if rpc_resp is not None:
                    conn.write(_http_response(status, json.dumps(rpc_resp)))
                else:
                    # Notification — return 200 with empty JSON
                    conn.write(_http_response(200, ""))

            else:
                conn.write(_http_response(404, json.dumps({"error": "Not Found"})))

        except Exception as ex:
            _log("ERROR handling request: " + str(ex))
            try:
                conn.write(_http_response(500, json.dumps({"error": "Internal server error"})))
            except Exception:
                pass

        self._close_connection(conn)

    def _close_connection(self, conn):
        """Disconnect and schedule cleanup via signal/slot as in KLayout template."""
        try:
            conn.disconnectFromHost()
            signal = pya.qt_signal("disconnected()")
            slot = pya.qt_slot("deleteLater()")
            pya.QObject.connect(conn, signal, conn, slot)
        except Exception as ex:
            _log("ERROR closing connection: " + str(ex))


# ---------------------------------------------------------------------------
# Singleton startup
# ---------------------------------------------------------------------------

_server = None

try:
    with open(_early_log, "a") as _f:
        _f.write("CREATING SERVER...\n")
    _server = KlayoutClawServer()
    with open(_early_log, "a") as _f:
        _f.write("SERVER CREATED OK\n")
except Exception as e:
    import traceback
    with open(_early_log, "a") as _f:
        _f.write("FATAL: {}\n{}\n".format(e, traceback.format_exc()))
    _log("FATAL: Failed to create server: " + str(e))
</text>
</klayout-macro>
