<?xml version="1.0" encoding="utf-8"?>
<klayout-macro>
 <description>KlayoutClaw MCP Server</description>
 <version>0.6</version>
 <category>pymacros</category>
 <prolog/>
 <epilog/>
 <doc/>
 <autorun>true</autorun>
 <autorun-early>false</autorun-early>
 <priority>0</priority>
 <shortcut/>
 <show-in-menu>false</show-in-menu>
 <group-name/>
 <menu-path/>
 <interpreter>python</interpreter>
 <dsl-interpreter-name/>
 <text>
import sys
import os
import io
import tempfile

# KLayout GUI app has no terminal — sys.stdout defaults to ASCII encoding.
# Reconfigure to UTF-8 so print() won't crash on non-ASCII characters.
if hasattr(sys.stdout, 'buffer'):
    sys.stdout = io.TextIOWrapper(sys.stdout.buffer, encoding='utf-8', errors='replace')
if hasattr(sys.stderr, 'buffer'):
    sys.stderr = io.TextIOWrapper(sys.stderr.buffer, encoding='utf-8', errors='replace')

# Early log to verify macro execution
_early_log = os.path.expanduser("~/.klayout/klayoutclaw.log")
with open(_early_log, "a") as _f:
    _f.write("MACRO STARTED (v0.6 QTcpServer)\n")

try:
    import pya
    with open(_early_log, "a") as _f:
        _f.write("PYA IMPORTED\n")
except Exception as _e:
    with open(_early_log, "a") as _f:
        _f.write("PYA IMPORT FAILED: {}\n".format(_e))

import json
import re
import uuid
import datetime
import traceback as _tb_mod

with open(_early_log, "a") as _f:
    _f.write("ALL IMPORTS OK\n")

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

_log_path = os.path.expanduser("~/.klayout/klayoutclaw.log")


def _log(msg):
    ts = datetime.datetime.now().isoformat()
    line = "[{}] {}".format(ts, msg)
    try:
        with open(_log_path, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except Exception:
        pass
    try:
        print("[KlayoutClaw] " + msg)
    except (UnicodeEncodeError, UnicodeDecodeError):
        print("[KlayoutClaw] " + msg.encode('ascii', errors='replace').decode('ascii'))
    try:
        if "_klayoutclaw" in sys.modules:
            cb = sys.modules["_klayoutclaw"]
            if msg.startswith("ERROR") and getattr(cb, "on_error", None):
                cb.on_error(msg)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# UI callback slots (shared via sys.modules["_klayoutclaw"])
# ---------------------------------------------------------------------------

import types as _types
if "_klayoutclaw" not in sys.modules:
    _claw_cb = _types.ModuleType("_klayoutclaw")
    _claw_cb.on_request = None       # fn(method, timestamp, success, error_msg)
    _claw_cb.on_server_start = None  # fn(port)
    _claw_cb.on_error = None         # fn(error_msg)
    _claw_cb.server_port = None      # int, set when server starts
    sys.modules["_klayoutclaw"] = _claw_cb


def _notify_request(method, success, error_msg=None):
    """Notify UI of a request (no-op if UI not loaded)."""
    try:
        cb = sys.modules.get("_klayoutclaw")
        if cb and cb.on_request:
            cb.on_request(method, datetime.datetime.now().strftime("%H:%M:%S"), success, error_msg)
    except Exception:
        pass


# ---------------------------------------------------------------------------
# Layout state
# ---------------------------------------------------------------------------

_layout_view = None
_layout = None
_top_cell = None
_exec_seq = 0


def _get_or_create_view():
    global _layout_view, _layout, _top_cell
    mw = pya.Application.instance().main_window()
    if mw is None:
        raise ValueError("KLayout main window not available")
    if mw.views() == 0:
        mw.create_layout(0)
    _layout_view = mw.current_view()
    if _layout_view is None:
        raise ValueError("No layout view available")
    cv = _layout_view.active_cellview()
    if cv is None or not cv.is_valid():
        mw.create_layout(0)
        _layout_view = mw.current_view()
        cv = _layout_view.active_cellview()
    _layout = cv.layout()
    if _layout.cells() == 0:
        _top_cell = _layout.create_cell("TOP")
    else:
        _top_cell = _layout.top_cell()
    return _layout_view, _layout, _top_cell


def _handles_stale():
    """Return True if cached _layout/_layout_view/_top_cell are stale."""
    global _layout_view, _layout, _top_cell
    if _layout is None or _layout_view is None or _top_cell is None:
        return True
    try:
        # Verify layout is still alive
        _layout.cells()
        # Verify the cellview is still valid
        cv = _layout_view.active_cellview()
        if cv is None or not cv.is_valid():
            return True
        # Verify cached layout matches the current view's layout
        if cv.layout() is not _layout:
            return True
        _top_cell.name
    except Exception:
        return True
    return False


def _ensure_valid_handles():
    """Refresh layout handles if they are stale."""
    if _handles_stale():
        _get_or_create_view()


# ---------------------------------------------------------------------------
# Session management
# ---------------------------------------------------------------------------

_session_id = None


def _ensure_session():
    global _session_id
    if _session_id is None:
        _session_id = str(uuid.uuid4())
    return _session_id


